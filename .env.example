# LAGIX Platform — Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ── IMPORTANT SECURITY RULES ──────────────────────────────────────────────────
# 1. NEVER expose your service_role key in this file or any client-side code
# 2. ALL business logic that requires elevated permissions must go through
#    Supabase Edge Functions or server-side API routes
# 3. Row Level Security (RLS) policies enforce tenant isolation — never bypass
# 4. The AI copilot routes queries through server-side verified metrics only
